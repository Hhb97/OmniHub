<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.6</version>
    <relativePath/>
  </parent>

  <groupId>com.omnihub</groupId>
  <artifactId>omnihub-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>
  <name>OmniHub backend</name>
  <description>General purpose IoT platform: one deployable, several modules</description>

  <!--
    Module order is the dependency order. Nothing below may depend on a module above it, and only `core`
    produces an executable artifact. See docs/architecture.md for the rules each module follows.
  -->
  <modules>
    <module>platform-common</module>
    <module>platform-messaging</module>
    <module>platform-identity</module>
    <module>platform-product</module>
    <module>platform-device</module>
    <module>platform-telemetry</module>
    <module>platform-command</module>
    <module>platform-alarm</module>
    <module>platform-realtime</module>
    <module>platform-ingest</module>
    <module>platform-dashboard</module>
    <module>core</module>
  </modules>

  <properties>
    <!-- Java 21 is the target; 17 is the minimum Boot 3.5 supports and what the development machine had.
         Build with -Djava.version=21 (the Dockerfile does). No 21-only API is used. -->
    <java.version>17</java.version>
    <mybatis-plus.version>3.5.12</mybatis-plus.version>
    <jjwt.version>0.12.6</jjwt.version>
    <springdoc.version>2.8.13</springdoc.version>
    <paho.version>1.2.5</paho.version>
    <moquette.version>0.17</moquette.version>
    <hivemq.version>1.3.3</hivemq.version>
    <zonky-pg.version>2.0.7</zonky-pg.version>
    <zonky-pg-bin.version>16.4.0</zonky-pg-bin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- internal modules: every module is versioned with the parent -->
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-messaging</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-identity</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-product</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-device</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-telemetry</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-command</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-alarm</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-realtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-ingest</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.omnihub</groupId>
        <artifactId>platform-dashboard</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- third party versions that Spring Boot does not manage -->
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-jsqlparser</artifactId>
        <version>${mybatis-plus.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-api</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-impl</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>io.jsonwebtoken</groupId>
        <artifactId>jjwt-jackson</artifactId>
        <version>${jjwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.paho</groupId>
        <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
        <version>${paho.version}</version>
      </dependency>
      <dependency>
        <groupId>io.moquette</groupId>
        <artifactId>moquette-broker</artifactId>
        <version>${moquette.version}</version>
      </dependency>
      <dependency>
        <groupId>com.hivemq</groupId>
        <artifactId>hivemq-mqtt-client</artifactId>
        <version>${hivemq.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
