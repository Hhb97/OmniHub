# Copy to .env (git-ignored) and fill in. Every value marked CHANGE_ME must be replaced; none has a usable default.

# --- PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE_ME

# --- Backend
# >= 32 characters, random. Example: openssl rand -base64 48
IOT_JWT_SECRET=CHANGE_ME
# Password of the first admin account (created only when no user exists). >= 8 characters.
IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=CHANGE_ME
# Account the platform itself uses to connect to the broker
IOT_MQTT_USERNAME=platform
IOT_MQTT_PASSWORD=CHANGE_ME
# Shared secret the broker sends to /api/mqtt/auth and /api/mqtt/acl (header X-Broker-Token)
IOT_MQTT_HTTP_AUTH_TOKEN=CHANGE_ME
# Browser origins allowed for CORS / WebSocket when frontend and API are on different origins (comma separated)
IOT_CORS_ORIGINS=
# Time zone for "today" on the dashboard
IOT_DASHBOARD_ZONE=Asia/Shanghai
# Enable Swagger UI (/swagger-ui.html). Keep false in production.
IOT_API_DOCS_ENABLED=false

# --- History storage: postgres (default) | influxdb (InfluxDB 1.x)
IOT_HISTORY_STORE=postgres
IOT_INFLUX_URL=http://localhost:8086
IOT_INFLUX_DB=iot
IOT_INFLUX_USER=
IOT_INFLUX_PASSWORD=

# --- Published ports
WEB_PORT=80
MQTT_PORT=1883
