# Copy to .env (git-ignored) and fill in. Every value marked CHANGE_ME must be replaced; none has a usable default.
# On a Docker host `OMNIHUB_ADMIN_PASSWORD=... sh deploy/vm-init-env.sh` creates .env with random secrets.

# --- PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE_ME

# --- InfluxDB 1.8 (property history, the default store in the compose stack)
INFLUX_DB=iot
INFLUX_USER=influx
INFLUX_PASSWORD=CHANGE_ME
IOT_INFLUX_RETENTION_DAYS=90

# --- EMQX dashboard (user: admin)
EMQX_DASHBOARD_PASSWORD=CHANGE_ME

# --- Monitoring (Grafana user: admin)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Bearer token Prometheus uses for the backend's /actuator/prometheus
IOT_METRICS_TOKEN=CHANGE_ME
PROMETHEUS_RETENTION=15d
# Filled in by deploy/emqx-bootstrap.sh when the EMQX metrics endpoint needs an API key
EMQX_API_KEY=
EMQX_API_SECRET=

# --- Backend
# >= 32 characters, random. Example: openssl rand -base64 48
IOT_JWT_SECRET=CHANGE_ME
# Password of the first admin account (created only when no user exists). >= 8 characters.
IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=CHANGE_ME
# Account the platform itself uses to connect to the broker
IOT_MQTT_USERNAME=platform
IOT_MQTT_PASSWORD=CHANGE_ME
# Shared secret the broker sends to /api/mqtt/auth and /api/mqtt/acl (header X-Broker-Token)
IOT_MQTT_HTTP_AUTH_TOKEN=CHANGE_ME
# Browser origins allowed for CORS / WebSocket when frontend and API are on different origins (comma separated)
IOT_CORS_ORIGINS=
# Time zone for "today" on the dashboard
IOT_DASHBOARD_ZONE=Asia/Shanghai
# Enable Swagger UI (/swagger-ui.html). Keep false in production.
IOT_API_DOCS_ENABLED=false
# history store: influxdb (default in the compose stack) | postgres
IOT_HISTORY_STORE=influxdb
# upstream path: direct | kafka. The compose stack runs its own single-node Kafka (service "kafka"), see docs/kafka-ingest.md
IOT_INGEST_MODE=direct
# Kafka (used when IOT_INGEST_MODE=kafka): partitions = consumer threads; retention is capped so a load test cannot fill the disk
# IOT_KAFKA_PARTITIONS=8
# IOT_KAFKA_CONCURRENCY=8
# IOT_KAFKA_ACKS=1
# KAFKA_RETENTION_BYTES=268435456   # per partition
# KAFKA_RETENTION_HOURS=6
# KAFKA_IMAGE=apache/kafka:3.9.0
# false = do not log successful property reports in the communication log (dashboard trend then under-counts)
IOT_LOG_OK_PROPERTY=true

# --- Published ports (PostgreSQL and InfluxDB are not published)
WEB_PORT=8088
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
GRAFANA_PORT=3000

# Optional: use images that are already on the host instead of pulling the defaults (uncomment and adjust)
# POSTGRES_IMAGE=postgres:16
# EMQX_IMAGE=emqx/emqx:5.8.0
# PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
