# Copy to .env (git-ignored) and fill in. Every value marked CHANGE_ME must be replaced; none has a usable default.
# On a Docker host `OMNIHUB_ADMIN_PASSWORD=... sh deploy/vm-init-env.sh` creates .env with random secrets.

# --- PostgreSQL
POSTGRES_DB=iot
POSTGRES_USER=iot
POSTGRES_PASSWORD=CHANGE_ME

# --- InfluxDB 1.8 (property history, the default store in the compose stack)
INFLUX_DB=iot
INFLUX_USER=influx
INFLUX_PASSWORD=CHANGE_ME
IOT_INFLUX_RETENTION_DAYS=90

# --- EMQX dashboard (user: admin)
EMQX_DASHBOARD_PASSWORD=CHANGE_ME

# --- Monitoring (Grafana user: admin)
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# Bearer token Prometheus uses for the backend's /actuator/prometheus
IOT_METRICS_TOKEN=CHANGE_ME
PROMETHEUS_RETENTION=15d
# PostgreSQL (docs/tuning.md): the compose file starts it with tuned settings; override here
# PG_SHARED_BUFFERS=2GB            PG_EFFECTIVE_CACHE_SIZE=6GB       PG_MAX_WAL_SIZE=8GB     PG_MAX_CONNECTIONS=200
# PG_SYNCHRONOUS_COMMIT=on         off = much faster commits, a crash can lose the last few hundred ms of commits
# IOT_DB_POOL=40                   backend connection pool (must stay below PG_MAX_CONNECTIONS)
# EMQX limits that matter at thousands of messages per second (defaults shown; see docs/tuning.md)
# Unacknowledged QoS 1 messages per subscriber: the broker half of the uplink window. Must be >=
# IOT_MQTT_MAX_INFLIGHT below - the smaller of the two wins. EMQX's own default is 32.
EMQX_MAX_INFLIGHT=4096
# EMQX_MAX_MQUEUE_LEN=100000     queued messages per subscriber when the window is full (EMQX default 1000)
# EMQX_MAX_MAILBOX_SIZE=100000   a connection process is shut down above this many pending messages (default 1000)
# EMQX_MAX_HEAP_SIZE=512MB       ... or above this heap size (default 32MB)
# EMQX_TCP_BACKLOG=4096          listen backlog; keep it at or below the host's net.core.somaxconn
# How the broker spreads a shared subscription over the platform's N connections. hash_clientid keeps every
# message of one device on the same connection (per-device ordering); round_robin balances better but scrambles it.
# Maps to mqtt.shared_subscription_strategy on EMQX 5.7+ (docs/tuning.md §8).
EMQX_SHARED_SUBSCRIPTION_STRATEGY=hash_clientid
# Filled in by deploy/emqx-bootstrap.sh when the EMQX metrics endpoint needs an API key
EMQX_API_KEY=
EMQX_API_SECRET=

# --- Backend
# >= 32 characters, random. Example: openssl rand -base64 48
IOT_JWT_SECRET=CHANGE_ME
# Password of the first admin account (created only when no user exists). >= 8 characters.
IOT_ADMIN_USERNAME=admin
IOT_ADMIN_PASSWORD=CHANGE_ME
# Account the platform itself uses to connect to the broker
IOT_MQTT_USERNAME=platform
IOT_MQTT_PASSWORD=CHANGE_ME
# Shared secret the broker sends to /api/mqtt/auth and /api/mqtt/acl (header X-Broker-Token)
IOT_MQTT_HTTP_AUTH_TOKEN=CHANGE_ME
# Number of connections that share the uplink subscription ($share/<group>/...). One connection is one broker
# session with one delivery queue, which is what caps a single-instance deployment at a few thousand msg/s.
# Set to 1 for a broker without shared subscriptions.
# Throughput = connections x max-inflight / ack round trip, so this and the next value are the two halves of the
# uplink ceiling. 4 x 1024 stalls around 2-4k msg/s; the measured profile below sustains 15k msg/s.
IOT_MQTT_INGEST_CONNECTIONS=16
# Receive window per connection (Paho maxInflight). Keep it <= EMQX_MAX_INFLIGHT: the smaller of the two wins.
# 8 × 1024 stalled at 4.6k msg/s with every window full and 400k messages queued at the broker;
# 16 × 4096 (= 65536 in flight) processed a full 15k msg/s with the broker queue at zero.
IOT_MQTT_MAX_INFLIGHT=4096
IOT_MQTT_SHARED_GROUP=ingest
# Browser origins allowed for CORS / WebSocket when frontend and API are on different origins (comma separated)
IOT_CORS_ORIGINS=
# Time zone for "today" on the dashboard
IOT_DASHBOARD_ZONE=Asia/Shanghai
# Enable Swagger UI (/swagger-ui.html). Keep false in production.
IOT_API_DOCS_ENABLED=false
# history store: influxdb (default in the compose stack) | postgres
IOT_HISTORY_STORE=influxdb
# upstream path: direct | kafka. The compose stack runs its own single-node Kafka (service "kafka"), see docs/kafka-ingest.md
IOT_INGEST_MODE=direct
# Kafka (used when IOT_INGEST_MODE=kafka): partitions = consumer threads; retention is capped so a load test cannot fill the disk
# IOT_KAFKA_PARTITIONS=8
# IOT_KAFKA_CONCURRENCY=8
# IOT_KAFKA_ACKS=1
# KAFKA_RETENTION_BYTES=268435456   # per partition
# KAFKA_RETENTION_HOURS=6
# KAFKA_IMAGE=apache/kafka:3.9.0
# Communication log: whether every successful property report is written to iot_device_message_log.
# Off by default: that table is a full detail log (one row + three index entries per report), it caps ingest at
# about 4.2k rows/s and grows ~13 GB/hour at 10k msg/s - with it on, the default profile drops to 2.0k msg/s and
# loses messages (docs/perf-ingest-retro.md §7). The dashboard trend under-counts while this is off.
# true = log every successful report (only for small deployments or when auditing matters).
IOT_LOG_OK_PROPERTY=false
# PostgreSQL synchronous_commit for the ingestion pool (on | off | local | remote_write | remote_apply).
# off = a batch commit no longer waits for the WAL fsync. Without it the ingest writers sit in WALWrite waits and
# that wait caps the whole ingest pipeline (docs/tuning.md §8.8). Cost: on an OS crash the last few hundred ms of
# telemetry writes are lost; the database stays consistent. Set to on for fully synchronous writes.
IOT_INGEST_SYNCHRONOUS_COMMIT=off

# --- Published ports (PostgreSQL and InfluxDB are not published)
WEB_PORT=8088
MQTT_PORT=1883
EMQX_DASHBOARD_PORT=18083
GRAFANA_PORT=3000

# Optional: use images that are already on the host instead of pulling the defaults (uncomment and adjust)
# POSTGRES_IMAGE=postgres:16
# EMQX_IMAGE=emqx/emqx:5.8.0
# PROMETHEUS_IMAGE=prom/prometheus:v2.53.0
